# Copy to .env.local (dev) or set in your host's environment variables.

# A GitHub personal access token (no scopes needed — the data is public) so the
# GraphQL scout can run well above the ~60 req/hr unauthenticated limit.
GITHUB_TOKEN=

# Alternative: a comma-separated pool of tokens; each scout is hash-sharded to
# one token with a single failover retry on rate limits. Either GITHUB_TOKEN
# or GITHUB_TOKENS is required for live profiles.
# GITHUB_TOKENS=token1,token2

# Optional read-through cache (2h TTL) + the all-time scout counter. Without
# it, every scout hits GitHub live and the rate limit is enforced per instance.
# REDIS_URL=redis://localhost:6379

# GitHub OAuth App (optional) — lets a visitor match their OWN profile in one
# click ("Match your own GitHub" on the home page). Create an OAuth App at
# github.com/settings/developers with the callback URL:
#     <your-origin>/api/auth/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Optional: your public origin, used to build OAuth redirect URLs when
# VERCEL_URL isn't set (e.g. self-hosted / VPS deploys). Defaults to
# http://localhost:3000 in dev.
# NEXT_PUBLIC_APP_URL=https://gittinder.com
